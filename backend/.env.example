# Copia este archivo como .env.development (y .env.production para produccion) y rellena los valores.
# Esos archivos NUNCA se suben a GitHub (estan en .gitignore).

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Base de datos (MySQL)
DB_HOST=db
DB_USER=
DB_PASS=
DB_NAME=animefav
DB_ROOT_PASSWORD=
# DATABASE_URL lo usa Prisma: mysql://USUARIO:PASSWORD@HOST:3306/BASEDATOS
DATABASE_URL=

# Autenticacion
JWT_SECRET=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email en desarrollo (Mailtrap)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=

# Email en produccion (Resend)
RESEND_API_KEY=

# Cloudinary (avatares)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
